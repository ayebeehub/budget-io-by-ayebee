{
  "name": "budget-io-by-ayebee",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:domain",
    "test:domain": "tsc -p tsconfig.domain.json && node --test tests/domain.test.mjs tests/navigation.test.mjs tests/ingestion.test.mjs",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.11"
  }
}
